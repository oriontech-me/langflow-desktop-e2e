{
  "name": "langflow-desktop-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "E2E tests for IBM Langflow Desktop (Windows) with WebdriverIO + tauri-driver",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.31.2",
    "edgedriver": "6.3.1",
    "typescript": "5.9.3",
    "webdriverio": "9.31.9"
  },
  "engines": {
    "node": ">=20"
  }
}
